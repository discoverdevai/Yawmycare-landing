# Book a Demo form (src/components/sections/DemoModal.astro)
#
# Full https URL that receives the form as a JSON POST (CORS must allow the site origin and the
# Content-Type header). The destination is still to be chosen by the owner: an email service, a CRM
# form endpoint, or a Google Sheet web app. This value ships in the public JS bundle (PUBLIC_ prefix),
# so it must be a write-only endpoint. Never put an API key, token or admin URL here.
#
# Unset: `astro dev` simulates success and logs a warning; a production build shows a
# "not connected yet" error instead of faking success.
PUBLIC_DEMO_FORM_ENDPOINT=

# Social profiles (Header top bar + Footer). Full https URLs. Any left empty is NOT rendered in
# production (dev shows it with a dashed outline). WhatsApp may also be a phone number.
PUBLIC_SOCIAL_LINKEDIN=
PUBLIC_SOCIAL_INSTAGRAM=
PUBLIC_SOCIAL_WHATSAPP=
PUBLIC_SOCIAL_FACEBOOK=

# Contact shown in the demo form's "not connected yet" message. WhatsApp: https URL or phone number
# with country code; email: plain address. Unset: the message is plain text without links.
PUBLIC_CONTACT_WHATSAPP=
PUBLIC_CONTACT_EMAIL=

# "Watch demo / tour" video (Hero, Setup band, Final CTA). Full https URL, opened in a new tab.
# Unset: the three buttons are not rendered in production.
PUBLIC_DEMO_VIDEO_URL=

# Per-region contact and price (docs/ENV.md "Regions"). Regions: EG (Egypt, EGP), SA (Saudi Arabia, SAR),
# US (United States, USD). Everything unset is HIDDEN in production (no number or price is ever invented);
# `astro dev` shows the missing pieces with a dashed outline. If no region has anything set, the region switch,
# the floating WhatsApp button and the hero WhatsApp CTA are not rendered at all.
#   *_WHATSAPP      phone number with country code (digits, "+" and spaces are fine); builds https://wa.me/<digits>
#   *_PHONE         phone number shown in the footer as a tel: link
#   *_PRICE_AMOUNT  plain number per month, e.g. 1500 (currency is fixed per region, period is always one month)
#   *_PRICE_NOTE    optional short note under the price (English); *_PRICE_NOTE_AR is the Arabic version
PUBLIC_REGION_EG_WHATSAPP=
PUBLIC_REGION_EG_PHONE=
PUBLIC_REGION_EG_PRICE_AMOUNT=
PUBLIC_REGION_EG_PRICE_NOTE=
PUBLIC_REGION_EG_PRICE_NOTE_AR=
PUBLIC_REGION_SA_WHATSAPP=
PUBLIC_REGION_SA_PHONE=
PUBLIC_REGION_SA_PRICE_AMOUNT=
PUBLIC_REGION_SA_PRICE_NOTE=
PUBLIC_REGION_SA_PRICE_NOTE_AR=
PUBLIC_REGION_US_WHATSAPP=
PUBLIC_REGION_US_PHONE=
PUBLIC_REGION_US_PRICE_AMOUNT=
PUBLIC_REGION_US_PRICE_NOTE=
PUBLIC_REGION_US_PRICE_NOTE_AR=
