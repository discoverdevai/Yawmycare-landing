---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/sections/Header.astro";
import Hero from "@/components/sections/Hero.astro";
import DayTimeline from "@/components/sections/DayTimeline.astro";
import Features from "@/components/sections/Features.astro";
import Compare from "@/components/sections/Compare.astro";
import Proof from "@/components/sections/Proof.astro";
import Roles from "@/components/sections/Roles.astro";
import Setup from "@/components/sections/Setup.astro";
import Security from "@/components/sections/Security.astro";
import Pricing from "@/components/sections/Pricing.astro";
import Faq from "@/components/sections/Faq.astro";
import FinalCta from "@/components/sections/FinalCta.astro";
import Footer from "@/components/sections/Footer.astro";
import DemoModal from "@/components/sections/DemoModal.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import { locales, type Locale } from "@/i18n";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;

//  Page order and joins (docs/FIX-LOG-final-structure.md): hero (scalloped bottom) -> [proof: renders nothing while config/proof.ts is empty]
//  -> roles (plain, so the hero scallop meets cream) -> day (light) -> features -> compare (sec) -> how it works (setup) -> security + promises (light, runs under
//  pricing's scalloped top) -> pricing -> FAQ (sec) -> final CTA + footer (scalloped top). Everything else is a flat join.
//  Testimonials and Founders are unpublished (docs/DECISIONS.md 27-28); Commitments is merged into Security (29).
//  FinalCta must be the last section in <main> with Footer straight after it (the footer overlaps the band).
---

<BaseLayout locale={locale}>
  <JsonLd slot="head" locale={locale} />
  <Header slot="header" locale={locale} />
  <Hero locale={locale} />
  <Proof locale={locale} />
  <Roles locale={locale} />
  <DayTimeline locale={locale} />
  <Features locale={locale} />
  <Compare locale={locale} />
  <Setup locale={locale} />
  <Security locale={locale} />
  <Pricing locale={locale} />
  <Faq locale={locale} />
  <FinalCta locale={locale} />
  <Footer slot="footer" locale={locale} />
  <DemoModal slot="footer" locale={locale} />
</BaseLayout>
