---
import { getDictionary, localeMeta, locales, type Locale } from "@/i18n";
import { contact, isConfigured, regionIds, regions, socials } from "@/config/site";

/**
 * Organization, WebSite, WebPage and SoftwareApplication as one @graph (the FAQPage block comes from Faq.astro).
 * All text is built from the existing dictionary (`brand`, `meta`); no new i18n keys.
 * No `offers`: the price is not public and must not be invented. `sameAs`, `areaServed` and `contactPoint`
 * come from `src/config/site.ts` and are omitted until the owner configures them.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const inLanguage = localeMeta[locale].htmlLang;
const origin = new URL(Astro.site!).origin;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const logo = new URL("/icon-512.png", Astro.site).href;

// sameAs: real profile pages only (WhatsApp is a chat link, not a profile). Empty until the owner sets PUBLIC_SOCIAL_*.
const sameAs: string[] = [socials.linkedin, socials.instagram, socials.facebook].filter((url) => isConfigured(url));

// areaServed: only regions the owner has actually configured (a contact or a price). Unset = omitted, never guessed.
const countries: Record<string, { name: string; code: string }> = {
  eg: { name: "Egypt", code: "EG" },
  sa: { name: "Saudi Arabia", code: "SA" },
  us: { name: "United States", code: "US" },
};
const areaServed = regionIds
  .filter((id) => regions[id].whatsapp || regions[id].phone || regions[id].price)
  .map((id) => ({ "@type": "Country", name: countries[id]!.name, identifier: countries[id]!.code }));

// Only the email contact point, and only when configured (mailto: is stripped for the schema value).
const email = contact.email.replace(/^mailto:/i, "");

// featureList: the feature titles printed in the Features section, nothing else.
const featureList = t.sections.features.items.map((item) => item.title);

// Names in both languages so a search for either spelling resolves to the same entity.
const otherName = getDictionary(locales.find((l) => l !== locale)!).brand.name;
const names = { name: t.brand.name, alternateName: otherName };

const orgId = `${origin}/#organization`;
const siteId = `${origin}/#website`;
const pageId = `${pageUrl}#webpage`;

const graph = [
  {
    "@type": "Organization",
    "@id": orgId,
    ...names,
    slogan: t.brand.tagline,
    url: `${origin}/`,
    logo: { "@type": "ImageObject", url: logo, width: 512, height: 512 },
    ...(sameAs.length ? { sameAs } : {}),
    ...(areaServed.length ? { areaServed } : {}),
    ...(email ? { contactPoint: { "@type": "ContactPoint", contactType: "sales", email } } : {}),
  },
  {
    "@type": "WebSite",
    "@id": siteId,
    ...names,
    url: `${origin}/`,
    inLanguage,
    publisher: { "@id": orgId },
  },
  {
    "@type": "WebPage",
    "@id": pageId,
    url: pageUrl,
    name: t.meta.title,
    description: t.meta.description,
    inLanguage,
    isPartOf: { "@id": siteId },
    about: { "@id": `${origin}/#software` },
    publisher: { "@id": orgId },
  },
  {
    "@type": "SoftwareApplication",
    "@id": `${origin}/#software`,
    name: t.brand.name,
    alternateName: otherName,
    description: t.meta.description,
    url: pageUrl,
    // The product itself is available in both languages, whichever page describes it.
    inLanguage: ["en", "ar"],
    applicationCategory: "BusinessApplication",
    // The page presents web dashboard + parent and teacher mobile apps.
    operatingSystem: "Web, iOS, Android",
    featureList,
    ...(areaServed.length ? { areaServed } : {}),
    publisher: { "@id": orgId },
  },
];

// Escape "<" and U+2028/2029 so no string can close the script element (doubled backslash on purpose).
const html = JSON.stringify({ "@context": "https://schema.org", "@graph": graph })
  .replace(/</g, "\\u003c")
  .replace(/\u2028/g, "\\u2028")
  .replace(/\u2029/g, "\\u2029");
---

<script type="application/ld+json" set:html={html} />
