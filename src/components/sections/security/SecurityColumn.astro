---
import AnimatedImage from "@/components/ui/AnimatedImage.astro";
import BlobCard from "@/components/ui/BlobCard.astro";

/**
 * One column of security cards (a real list, one card per item). From 1024 the cards share the column height
 * (flex-1), so both columns end up with equal cards and aligned top and bottom edges.
 */
interface Item {
  title: string;
  body: string;
  icon: ImageMetadata;
  /** First frame, shown instead of the animation for reduced motion / paused. */
  still: ImageMetadata;
}
interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<ul class="flex flex-col gap-6 lg:gap-12">
  {items.map((item) => (
    <BlobCard as="li" shape="security" stretch="lg" class="lg:flex-1" contentClass="flex flex-col gap-4 p-6 xl:p-8">
      <AnimatedImage src={item.icon} still={item.still} width={85} height={85} class="size-[85px]" />
      <div class="flex flex-col gap-3">
        <h3 class="text-h3 text-accent-text font-bold">{item.title}</h3>
        <p class="text-lead text-ink">{item.body}</p>
      </div>
    </BlobCard>
  ))}
</ul>
