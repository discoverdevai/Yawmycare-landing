---
import type { ImageMetadata } from "astro";
import BlobCard from "@/components/ui/BlobCard.astro";

/**
 * One commitment: blob card + corner illustration + title + body.
 *
 * Everything scales with the card's own width (container query units), so the Figma proportions
 * (58px padding and a 110px illustration on a 588px card; 118px padding on the 1200px wide card)
 * hold at any width in between. Below the blob threshold the card is a plain rounded card and the
 * illustration moves into the flow, above the title, so nothing can overlap or poke out of the card.
 * The illustrations are already-optimised animated WebP (220px = 2x of the 110px slot), so they use a plain
 * <img src> instead of <Image>: re-encoding them through sharp made the files bigger.
 * (The still's srcset URL has spaces encoded: an unencoded space splits a srcset candidate, which breaks it in dev under a path with spaces.)
 * The illustration sits at the inline end (top-right in LTR, top-left in RTL) via logical offsets.
 */
interface Props {
  shape: "commitment-peach" | "commitment-green" | "commitment-wide";
  title: string;
  body: string;
  icon: ImageMetadata;
  /** First frame of the illustration, shown instead of the animation when the visitor prefers reduced motion. */
  iconStill: ImageMetadata;
  /** Title colour utility (accent-text on peach, primary-text on green). */
  titleClass: string;
  class?: string;
}

const { shape, title, body, icon, iconStill, titleClass, class: className = "" } = Astro.props;
const wide = shape === "commitment-wide";

// Literal class strings (Tailwind scans source). Blob shows from 441px (small) / 900px (wide) of card width.
const pad = wide
  ? "p-6 @min-[900px]:px-[9.83%] @min-[900px]:py-[4%]"
  : "p-6 @min-[441px]:p-[9.86%]";
const iconPos = wide
  ? "@min-[900px]:absolute @min-[900px]:top-[0.25cqw] @min-[900px]:end-[7.08cqw] @min-[900px]:size-[9.17cqw]"
  : "@min-[441px]:absolute @min-[441px]:top-0 @min-[441px]:end-[4.08cqw] @min-[441px]:size-[18.7cqw]";
const titleGap = wide ? "@min-[900px]:pe-0" : "@min-[441px]:pe-[12.9cqw]";
---

<BlobCard shape={shape} as="li" contentClass={pad} class:list={["flex flex-col [&>div]:flex-1", className]}>
  <picture
    aria-hidden="true"
    class:list={["pointer-events-none mb-4 block size-[72px] shrink-0 overflow-hidden", iconPos]}
  >
    <source media="(prefers-reduced-motion: reduce)" srcset={iconStill.src.replace(/ /g, "%20")} type="image/webp" />
    <img src={icon.src} alt="" width={110} height={110} loading="lazy" decoding="async" class="size-full object-cover" />
  </picture>
  <div class="flex flex-col gap-4 @min-[441px]:gap-6">
    <h3 class:list={["text-h3 font-bold", titleClass, titleGap]}>{title}</h3>
    <p class:list={["text-lead", wide && "font-medium"]}>{body}</p>
  </div>
</BlobCard>
