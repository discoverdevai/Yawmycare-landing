---
import { Picture } from "astro:assets";
import Section from "@/components/ui/Section.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import DeviceFrame from "@/components/ui/DeviceFrame.astro";
import Icon, { type IconName } from "@/components/ui/Icon.astro";
import dashboard from "@/assets/product/owner-dashboard-1659-29977.webp";
import teacher from "@/assets/product/teacher-logs-876-53138.webp";
import parent from "@/assets/product/parent-home-606-38038.webp";
import dashboardAr from "@/assets/product/ar/dashboard-ar.png";
import teacherAr from "@/assets/product/ar/teacher-ar.png";
import parentAr from "@/assets/product/ar/parent-ar.png";
import { getDictionary, type Locale } from "@/i18n";

/**
 * Owner / Teacher / Parent switcher (NEXT-PLAN A2). Capabilities are the app-coverage.md switcher table (all backed by Figma frames).
 * Screens: owner 1659:29977 (chart + recent activity crop, stat cards cropped out), teacher 876:53138, parent 606:38038.
 * The AR page uses the Arabic RTL mockups (src/assets/product/ar, docs/FIX-LOG-arabic-screens.md); other locales use the English app screens.
 *
 * Without JS all three panels are shown stacked and the tablist stays hidden; the script reveals the tablist, hides the
 * inactive panels and wires the WAI-ARIA tabs pattern (roving tabindex, arrows with RTL swap, Home/End).
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).sections.roles;

const isAr = locale === "ar";
const shots = {
  owner: {
    src: isAr ? dashboardAr : dashboard,
    w: 1600,
    h: 913,
    widths: [560, 840, 1120],
    sizes: "(min-width: 1024px) 38rem, calc(100vw - 3rem)",
  },
  teacher: { src: isAr ? teacherAr : teacher, w: 750, h: 1624, widths: [260, 390, 520], sizes: "16rem" },
  parent: { src: isAr ? parentAr : parent, w: 750, h: 1624, widths: [260, 390, 520], sizes: "16rem" },
} as const;
// One tile icon per role (ui/Icon tile): owner = the nursery, teacher = photos and logs, parent = the chat.
const roleIcon: Record<string, IconName> = { owner: "school", teacher: "camera", parent: "chat" };
---

<Section id="roles" headingId="roles-title">
  <SectionHeader slot="header" id="roles-title" title={t.title} lead={t.lead} />
  <div class="roles" data-roles>
    <div role="tablist" aria-label={t.tablistLabel} class="roles-tabs" hidden>
      {t.roles.map((r, i) => (
        <button
          type="button"
          role="tab"
          id={`role-tab-${r.id}`}
          aria-controls={`role-panel-${r.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          class="roles-tab text-button"
        >
          {r.tab}
        </button>
      ))}
    </div>
    <div class="roles-panels">
      {t.roles.map((r) => {
        const shot = shots[r.id as keyof typeof shots];
        const wide = r.id === "owner";
        return (
          <div
            role="tabpanel"
            id={`role-panel-${r.id}`}
            aria-labelledby={`role-tab-${r.id}`}
            tabindex="0"
            class="roles-panel"
          >
            <div class="roles-copy">
              <Icon name={roleIcon[r.id] ?? "school"} size={22} tile class="mb-3" />
              <p class="text-accent-text text-caption font-bold" data-kicker>
                {r.tab}
              </p>
              <h3 class="text-h3 text-primary-text mt-1 font-bold">{r.heading}</h3>
              <ul role="list" class="mt-5 flex flex-col gap-3">
                {r.items.map((it) => (
                  <li class="text-body text-ink flex gap-3">
                    <span class="roles-check" aria-hidden="true">
                      <svg
                        viewBox="0 0 24 24"
                        width="16"
                        height="16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="m5 12.5 4.5 4.5L19 7.5" />
                      </svg>
                    </span>
                    <span>{it}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class:list={["roles-shot", wide ? "roles-shot--wide" : "roles-shot--phone"]}>
              <DeviceFrame kind={wide ? "browser" : "phone"} rise="view" class="roles-device">
                <Picture
                  src={shot.src}
                  alt={r.imageAlt}
                  formats={["avif"]}
                  fallbackFormat="webp"
                  widths={[...shot.widths]}
                  sizes={shot.sizes}
                  width={shot.w}
                  height={shot.h}
                  loading="lazy"
                  decoding="async"
                  class="block h-auto w-full"
                />
              </DeviceFrame>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</Section>

<style>
  .roles-tabs {
    display: flex;
    gap: 0.5rem;
    padding: 0.375rem;
    margin-bottom: 1.5rem;
    width: fit-content;
    max-width: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-stroke-green);
    border-radius: var(--radius-pill);
  }
  .roles-tabs[hidden] {
    display: none;
  }
  .roles-tab {
    min-height: 3rem;
    padding-inline: clamp(0.5rem, 3.5vw, 1.25rem);
    flex: 1 1 auto;
    min-width: 0;
    border-radius: var(--radius-pill);
    color: var(--color-primary-text);
    font-weight: 700;
    white-space: nowrap;
    cursor: pointer;
  }
  .roles-tab:hover {
    background: var(--color-primary-bg);
  }
  .roles-tab[aria-selected="true"] {
    background: var(--color-primary-cta-strong);
    color: var(--color-on-cta);
  }
  .roles-tab:focus-visible,
  .roles-panel:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
  .roles-panels {
    display: grid;
    gap: 2.5rem;
  }
  .roles-panel {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    padding: 1.25rem;
    background: var(--color-surface);
    border: 3px solid var(--color-stroke-green);
    border-radius: var(--radius-card);
  }
  .roles-check {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    margin-block-start: 0.125rem;
    border-radius: 50%;
    background: var(--color-primary-bg);
    color: var(--color-primary-cta-strong);
  }
  /* The device sits on one large-opposite-corner blob, offset down and to the end (art direction, blob masks). */
  .roles-shot {
    position: relative;
    isolation: isolate;
    justify-self: center;
    display: grid;
    place-items: center;
    width: 100%;
    padding: 1.5rem 1rem;
  }
  .roles-shot::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--color-primary-bg);
    border-start-start-radius: 5rem;
    border-end-end-radius: 5rem;
    border-start-end-radius: 1.25rem;
    border-end-start-radius: 1.25rem;
  }
  .roles-shot--wide :global(.roles-device) {
    width: 100%;
  }
  .roles-shot--phone :global(.roles-device) {
    width: min(100%, 13.5rem);
  }
  /* With JS: one panel at a time. All panels share one grid cell, so the tallest sets the height and switching
     tabs never moves the page; the inactive ones are visibility:hidden (out of the accessibility tree, not focusable). */
  [data-roles][data-enhanced] .roles-panels {
    grid-template-areas: "stack";
    gap: 0;
  }
  [data-roles][data-enhanced] .roles-panel {
    grid-area: stack;
  }
  [data-roles][data-enhanced] .roles-panel[hidden] {
    display: grid;
    visibility: hidden;
    pointer-events: none;
  }
  [data-roles][data-enhanced] [data-kicker] {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    /* Tab change: the incoming panel cross-fades in 200ms (opacity only). Not on first load. */
    [data-roles][data-switched] .roles-panel:not([hidden]) {
      animation: fade-in 200ms ease-out;
    }
    html:has([data-motion-toggle][aria-pressed="true"]) [data-roles] .roles-panel {
      animation: none;
    }
  }
  @media (min-width: 64rem) {
    .roles-panel {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 3rem;
      padding: 2rem 2.5rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-roles]").forEach((root) => {
    const list = root.querySelector<HTMLElement>('[role="tablist"]');
    const tabs = Array.from(root.querySelectorAll<HTMLElement>('[role="tab"]'));
    const panels = tabs.map((t) => root.querySelector<HTMLElement>(`#${t.getAttribute("aria-controls")}`)!);
    if (!list || !tabs.length) return;
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute("aria-selected", String(i === j));
        t.tabIndex = i === j ? 0 : -1;
        panels[j].hidden = i !== j;
      });
      if (focus) tabs[i].focus();
    };
    root.setAttribute("data-enhanced", "");
    list.hidden = false;
    select(0);
    tabs.forEach((t, i) =>
      t.addEventListener("click", () => {
        root.setAttribute("data-switched", "");
        select(i);
      }),
    );
    list.addEventListener("keydown", (e) => {
      const rtl = getComputedStyle(list).direction === "rtl";
      const cur = tabs.findIndex((t) => t.getAttribute("aria-selected") === "true");
      let next = -1;
      if (e.key === "ArrowRight") next = cur + (rtl ? -1 : 1);
      else if (e.key === "ArrowLeft") next = cur + (rtl ? 1 : -1);
      else if (e.key === "Home") next = 0;
      else if (e.key === "End") next = tabs.length - 1;
      else return;
      e.preventDefault();
      root.setAttribute("data-switched", "");
      select((next + tabs.length) % tabs.length, true);
    });
  });
</script>
