---
import Icon, { type IconName } from "@/components/ui/Icon.astro";
import DemoField from "./demo/DemoField.astro";
import Button from "@/components/ui/Button.astro";
import { getDictionary, type Locale } from "@/i18n";
import { contact, resolveLink, regionIds, whatsappStart } from "@/config/site";
import { hasPage, pagePath } from "@/config/pages";

/**
 * Section 13: the "Book a Demo" dialog, v2 (docs/FORM-SPEC.md, docs/FIX-LOG-form.md). A native dialog#demo that the whole
 * site opens with any `[data-demo-open]` element, an `href="#demo"` link or a `#demo` URL hash on load. Mount it once per page
 * (the lead wires it in index.astro).
 *
 * Step 1 (panel "form"): name, mobile / WhatsApp number, nursery name. Submitted to the endpoint at once, so a lead is never lost.
 * Step 2 (panel "enrich", optional and skippable): work email, number of children, what they use today, preferred date and time,
 * country (pre-filled from the page region). A second POST with the same `leadId`.
 * Then the "done" panel (next steps, WhatsApp link only when the current region has a number) or the "error" panel.
 *
 * Figma 1326:4515 (EN) / 1437:4595 (AR): 767 wide, 24/32 padding, radius 50, fields 48 high with a 20px radius and a 24px
 * leading icon; the date/time pair shares a row and repeats its icon at the end (there it opens the native picker). Icons sit
 * on the inline start, so RTL mirrors the layout for free.
 *
 * The behaviour lives in src/scripts/demo-modal.ts, bundled by Astro via the one-line script below (progressive enhancement:
 * the dialog cannot open without it, and the form never posts anywhere on its own). All copy comes from i18n; user input is
 * only ever written back with textContent.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const t = dict.sections.demo;

// "Not connected yet" error: link to the configured WhatsApp / email (docs/ENV.md). Unset: plain text, no links.
const contactLinks = [
  { key: "whatsapp", icon: "whatsapp", label: dict.cta.contactWhatsApp, href: resolveLink(contact.whatsapp) },
  { key: "email", icon: "sms", label: dict.cta.contactEmail, href: resolveLink(contact.email) },
].filter((c) => !c.href.unconfigured) as { key: string; icon: IconName; label: string; href: { href: string } }[];

// Done panel: the same region-aware WhatsApp link as the floating button (its script keeps `[data-wa-link]` in step with the
// region and hides it while the current region has no number). Not rendered at all in production when no region has a number.
const wa = whatsappStart(locale, dict.regions.whatsappMessage);

// Consent line under the first-step submit: shown only when the privacy page exists in this locale (src/config/pages.ts).
const privacyHref = hasPage("privacy", locale) ? pagePath("privacy", locale) : null;
const [consentBefore = "", consentAfter = ""] = dict.legal.consent.split("{link}");

const step1Fields = [
  { name: "name", icon: "profile", type: "text", autocomplete: "name", maxlength: 100 },
  // Digits are always Latin, so the number is left-to-right in both languages (dir on the input itself).
  { name: "phone", icon: "whatsapp", type: "tel", autocomplete: "tel", maxlength: 30, dir: "ltr" },
  { name: "nursery", icon: "school", type: "text", autocomplete: "organization", maxlength: 150 },
] as const;
const toolKeys = ["whatsapp", "excel", "paper", "other"] as const;

// Strings the script needs at runtime (validation, status and error copy).
const messages = {
  fields: {
    name: t.fields.name,
    phone: t.fields.phone,
    nursery: t.fields.nursery,
    email: t.fields.email,
    date: t.fields.date,
    time: t.fields.time,
  },
  summary: t.summary,
  submit: t.submit,
  submitting: t.submitting,
  step2Submit: t.step2.submit,
  error: t.error,
};

const titleClass = `font-bold text-ink ${locale === "ar" ? "text-h3" : "text-title"}`;
const panelClass = "px-5 py-8 sm:px-6";
const labelClass = "text-body-sm font-medium text-ink";
const inputClass =
  "demo-input h-12 w-full min-w-0 rounded-input border border-field-border bg-transparent text-body-sm text-ink " +
  "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus";
const chipClass =
  "inline-flex min-h-11 max-w-full items-center rounded-pill border border-field-border px-4 py-1 text-center text-body-sm text-ink [overflow-wrap:anywhere] " +
  "hover:bg-primary-bg motion-safe:transition-colors motion-safe:duration-150 " +
  "peer-checked:border-primary-cta-strong peer-checked:bg-primary-cta-strong peer-checked:text-on-cta peer-checked:hover:bg-primary-cta-hover " +
  "peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-focus";
---

<dialog
  id="demo"
  aria-labelledby="demo-title"
  aria-describedby="demo-lead"
  data-messages={JSON.stringify(messages)}
  class="rounded-modal bg-surface text-ink m-auto w-[min(47.9375rem,calc(100vw-2rem))] max-w-none overflow-hidden p-0 backdrop:bg-overlay focus-visible:outline-none"
>
  <button
    type="button"
    data-demo-close
    aria-label={t.closeLabel}
    class="bg-surface-tabs text-ink hover:bg-primary-bg focus-visible:outline-focus absolute end-4 top-4 z-10 inline-flex size-11 items-center justify-center rounded-full focus-visible:outline-2 focus-visible:outline-offset-2 motion-safe:transition-colors motion-safe:duration-150"
  >
    <Icon name="plus" size={24} class="rotate-45" />
  </button>

  <div class="demo-scroll max-h-[calc(100dvh-2rem)] overflow-y-auto overscroll-contain">
    <!-- step 1: idle / submitting -->
    <div data-panel="form" class={panelClass}>
      <div class="flex flex-col gap-2 pe-12">
        <h2 id="demo-title" class={titleClass}>
          {t.title}
        </h2>
        <p id="demo-lead" class="text-body-sm text-ink-muted [line-height:1.5]">
          {t.lead}
        </p>
      </div>

      <form data-demo-form method="post" novalidate class="mt-6 flex flex-col gap-5">
        <p class="text-caption text-ink-muted -mb-2">
          <span aria-hidden="true" class="text-accent-text">
            *
          </span>
          {dict.a11y.requiredFields}
        </p>
        <div class="flex flex-col gap-4">
          {step1Fields.map((f) => (
            <DemoField
              {...f}
              label={t.fields[f.name].label}
              placeholder={t.fields[f.name].placeholder}
              autofocus={f.name === "name"}
            />
          ))}

          <!-- Honeypot: invisible to people and assistive tech (aria-hidden + inert: no focus, no autofill), tempting to bots. -->
          <div aria-hidden="true" inert class="pointer-events-none absolute -z-10 size-px overflow-hidden opacity-0">
            <label for="demo-company-website">{t.honeypotLabel}</label>
            <input id="demo-company-website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
          </div>
        </div>

        <Button type="submit" variant="primary" icon={null} block data-demo-submit>
          {t.submit}
        </Button>
        {privacyHref && (
          <p class="text-caption text-ink-muted -mt-2 text-center" data-demo-consent>
            {consentBefore}
            <a
              href={privacyHref}
              target="_blank"
              rel="noopener"
              class="text-primary-text focus-visible:outline-focus rounded underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-offset-2"
            >
              {dict.legal.consentLink}
            </a>
            {consentAfter}
          </p>
        )}
      </form>
    </div>

    <!-- step 2: optional details (shown once step 1 reached the endpoint) -->
    <div data-panel="enrich" hidden class={panelClass}>
      <div class="flex flex-col gap-2 pe-12">
        <p class="text-primary-text text-caption flex items-center gap-2 font-medium">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path
              d="M5 12.5l4.5 4.5L19 7.5"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
          {t.step2.received}
        </p>
        <h2 id="demo-enrich-title" tabindex="-1" class={`${titleClass} focus-visible:outline-none`}>
          {t.step2.title}
        </h2>
        <p id="demo-enrich-lead" class="text-body-sm text-ink-muted [line-height:1.5]">
          {t.step2.lead}
        </p>
      </div>

      <form data-enrich-form method="post" novalidate class="mt-6 flex flex-col gap-6">
        <p class="text-caption text-ink-muted -mb-3">{t.step2.optionalNote}</p>

        <DemoField
          name="email"
          icon="sms"
          type="email"
          autocomplete="email"
          maxlength={254}
          required={false}
          label={t.fields.email.label}
          placeholder={t.fields.email.placeholder}
        />

        <fieldset class="m-0 min-w-0 border-0 p-0">
          <legend class={`${labelClass} mb-3 p-0`}>{t.fields.children.legend}</legend>
          <div class="flex flex-wrap gap-2">
            {t.step2.childrenOptions.map((label) => (
              <label class="relative max-w-full">
                <input type="radio" name="children" value={label} class="peer sr-only" />
                <span class={chipClass}>
                  <bdi dir="ltr">{label}</bdi>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="m-0 min-w-0 border-0 p-0">
          <legend class={`${labelClass} mb-3 p-0`}>{t.fields.tool.legend}</legend>
          <div class="flex flex-wrap gap-2">
            {toolKeys.map((key) => (
              <label class="relative max-w-full">
                <input type="radio" name="tool" value={key} class="peer sr-only" />
                <span class={chipClass}>{t.step2.toolOptions[key]}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2">
          <DemoField name="date" icon="calendar" type="date" picker required={false} label={t.fields.date.label} />
          <DemoField name="time" icon="clock" type="time" picker required={false} label={t.fields.time.label} />
        </div>

        <div class="flex flex-col gap-3">
          <label for="demo-region" class={labelClass}>
            {t.fields.region.label}
          </label>
          <div class="relative">
            <span class="text-ink-muted pointer-events-none absolute start-3 top-1/2 -translate-y-1/2">
              <Icon name="language" />
            </span>
            <select id="demo-region" name="region" class={`${inputClass} demo-select`}>
              {regionIds.map((id) => (
                <option value={id}>{dict.regions.names[id]}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="flex flex-col gap-3">
          <Button type="submit" variant="primary" icon={null} block data-enrich-submit>
            {t.step2.submit}
          </Button>
          <Button variant="outline-deep" icon={null} block data-demo-skip>
            {t.step2.skip}
          </Button>
        </div>
      </form>
    </div>

    <!-- done -->
    <div data-panel="done" hidden class={`${panelClass} flex flex-col items-center gap-6 text-center`}>
      <span class="bg-primary-bg text-primary-text inline-flex size-16 items-center justify-center rounded-full">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <path
            d="M5 12.5l4.5 4.5L19 7.5"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </span>
      <div class="flex flex-col gap-2">
        <h2 id="demo-done-title" tabindex="-1" class={`${titleClass} focus-visible:outline-none`}>
          {t.done.title}
        </h2>
        <p id="demo-done-body" class="text-body-sm text-ink-muted [line-height:1.5]">
          {t.done.body}
        </p>
      </div>
      <div class="bg-surface-tabs w-full rounded-3xl p-5 text-start">
        <h3 class="text-body-sm text-ink font-bold">{t.done.nextTitle}</h3>
        <ol class="text-body-sm text-ink-muted mt-3 list-decimal space-y-2 ps-5 [line-height:1.5]">
          {t.done.next.map((item) => (
            <li>{item}</li>
          ))}
        </ol>
      </div>
      <div class="flex w-full flex-col gap-3">
        {wa.render && (
          <Button
            variant="outline-deep"
            icon="whatsapp"
            href={wa.href}
            external
            block
            hidden={wa.hidden}
            unconfigured={wa.unconfigured}
            data-wa-link
            data-wa-text={dict.regions.whatsappMessage}
          >
            {dict.regions.chatOnWhatsApp}
          </Button>
        )}
        <Button variant="primary" icon={null} block data-demo-close>
          {t.done.close}
        </Button>
      </div>
    </div>

    <!-- error -->
    <div data-panel="error" hidden class={`${panelClass} flex flex-col items-center gap-6 text-center`}>
      <div class="flex flex-col gap-2">
        <h2 id="demo-error-title" tabindex="-1" class={`${titleClass} focus-visible:outline-none`}>
          {t.error.title}
        </h2>
        <p data-demo-error-body role="alert" class="text-body-sm text-ink-muted [line-height:1.5]">
          {t.error.body}
        </p>
        {contactLinks.length > 0 && (
          <div hidden data-demo-contact class="mt-4 flex flex-col justify-center gap-3 sm:flex-row">
            {contactLinks.map((c) => (
              <Button
                variant="outline-deep"
                icon={c.icon}
                href={c.href.href}
                external={!c.href.href.startsWith("mailto:")}
                class="sm:w-auto"
                block
              >
                {c.label}
              </Button>
            ))}
          </div>
        )}
      </div>
      <Button variant="primary" icon={null} block data-demo-retry>
        {t.error.retry}
      </Button>
    </div>

    <!-- The one persistent live region (never display:none, so announcements are reliable). It carries the summary
         announcement ("Please fix..." / "Sending..."); per-field errors are read through aria-describedby when focus lands
         on the field. Empty = zero height. It sits below whichever panel is showing. -->
    <p
      role="status"
      aria-live="polite"
      aria-atomic="true"
      data-demo-status
      class="text-caption text-accent-text px-5 text-center sm:px-6 [&:not(:empty)]:-mt-3 [&:not(:empty)]:pb-6"
    ></p>
  </div>
</dialog>

<style is:global>
  /* Lock page scroll while the modal is open; keep the scrollbar gutter so the page does not jump. */
  html:has(#demo[open]) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }
  #demo .demo-input {
    padding-block: 0;
    padding-inline: 3rem 0.75rem; /* 12 + 24 icon + 12 gap, as in Figma */
  }
  #demo .demo-input--picker {
    position: relative;
    padding-inline-end: 3rem; /* room for the trailing icon, which sits over the native picker button */
  }
  /* The trailing icon is decorative; the invisible native picker button sits on top of it. */
  #demo .demo-input--picker::-webkit-calendar-picker-indicator {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    width: 3rem;
    height: 100%;
    margin: 0;
    padding: 0;
    opacity: 0;
    cursor: pointer;
  }
  /* A Latin value (the email, the phone number) is set LTR inside an RTL page: swap the padding so the icon still clears the text. */
  html[dir="rtl"] #demo .demo-input[dir="ltr"] {
    padding-inline: 0.75rem 3rem;
  }
  /* An empty LTR field in an RTL page: keep its placeholder on the inline-start side like the other fields. */
  html[dir="rtl"] #demo .demo-input[dir="ltr"]:placeholder-shown {
    text-align: end;
  }
  #demo .demo-select {
    padding-inline: 3rem 0.75rem;
  }
</style>

<script>
  import { initDemoModal } from "@/scripts/demo-modal";

  initDemoModal();
</script>
