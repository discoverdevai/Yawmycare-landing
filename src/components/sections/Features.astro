---
import Section from "@/components/ui/Section.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import BlobCard from "@/components/ui/BlobCard.astro";
import AnimatedImage from "@/components/ui/AnimatedImage.astro";
import { getDictionary, type Locale } from "@/i18n";

/**
 * 05 · "Built for how nurseries really work" (nav: Why Yawmy, #why).
 * Four feature cards (2 x 2 from 640, one row of four from 1280; cut from six: photos live in the day timeline, "nursery pays" in pricing and commitments) on the `feature` blob. The illustrations are pre-optimised animated WebP
 * (docs/sections/05-features/optimise-illustrations.mjs), rendered by ui/AnimatedImage (reduced-motion still + page pause).
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).sections.features;

type Img = { default: ImageMetadata };
const files = import.meta.glob<Img>("@/assets/features/*.webp", { eager: true });
const img = (name: string) => {
  const found = files[`/src/assets/features/${name}.webp`];
  if (!found) throw new Error(`Feature illustration "${name}" not found in src/assets/features`);
  return found.default;
};

// The Arabic card gets a small "عربي" pill in the Arabic locale only.
const showBadge = (id: string) => locale === "ar" && id === "arabic";
---

<Section id="why" headingId="features-title" wave="up" shadow>
  <SectionHeader slot="header" id="features-title" title={t.title} />
  <ul role="list" class="grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-2 xl:grid-cols-4 lg:gap-y-8">
    {t.items.map((item) => {
      const anim = img(item.id);
      const still = img(`${item.id}-still`);
      return (
        <BlobCard as="li" shape="feature" stretch fillContent contentClass="flex flex-1 flex-col gap-6 p-6 xl:p-8">
          <div class="flex flex-col gap-3">
            <h3 class="text-title text-primary-text font-black">{item.title}</h3>
            <p class="text-body text-ink">{item.body}</p>
          </div>
          <div class="mt-auto flex flex-wrap items-end justify-between gap-4">
            <AnimatedImage src={anim} still={still} width={110} height={110} class="size-[110px] shrink-0" />
            {showBadge(item.id) && (
              <span
                lang="ar"
                dir="rtl"
                class="bg-primary-bg text-primary-text text-caption rounded-pill px-4 py-1 font-bold"
              >
                {t.arabicBadge}
              </span>
            )}
          </div>
        </BlobCard>
      );
    })}
  </ul>
</Section>
