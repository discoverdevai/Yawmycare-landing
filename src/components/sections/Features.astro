---
import Section from "@/components/ui/Section.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import BlobCard from "@/components/ui/BlobCard.astro";
import Icon, { type IconName } from "@/components/ui/Icon.astro";
import { getDictionary, type Locale } from "@/i18n";

/**
 * 05 · "Built for how nurseries really work" (nav: Why Yawmy, #why).
 * Six feature cards (1 column, 2 from 640, 3 from 1024, so 3 x 2 at desktop) on the `feature` blob. Icon beside the title at every width and
 * no min-height, so a card is as tall as its text. Every card uses the same calm static icon tile (ui/Icon `tile`, docs/FIX-LOG-art-direction.md); the old animated
 * illustrations clashed with the line language and were removed. Only capabilities that exist in the Figma app designs (docs/research/app-coverage.md).
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).sections.features;

// The Arabic card gets a small "عربي" pill in the Arabic locale only.
// The Arabic card gets a small "عربي" pill in the Arabic locale only.
const showBadge = (id: string) => locale === "ar" && id === "arabic";

// One icon language (ui/Icon tile): 2px rounded line + a soft tint shape; the accent dot only where it means "new".
const featureIcons: Record<string, { name: IconName; dot?: boolean }> = {
  "one-tap-checkin": { name: "pin-check" },
  announcements: { name: "bell", dot: true },
  safety: { name: "health" },
  "know-who-read": { name: "checks" },
  evenings: { name: "moon" },
  arabic: { name: "language" },
};
---

<Section id="why" headingId="features-title">
  <SectionHeader slot="header" id="features-title" title={t.title} />
  <ul role="list" class="grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-y-8">
    {t.items.map((item) => {
      const icon = featureIcons[item.id] ?? { name: "sparkle" as IconName };
      return (
        <BlobCard
          as="li"
          shape="feature"
          stretch
          fillContent
          class="lift"
          contentClass="flex flex-1 flex-col gap-4 p-6 xl:p-8"
        >
          <div class="flex items-center gap-4">
            <Icon name={icon.name} size={32} tile dot={icon.dot} />
            <h3 class="text-title text-primary-text min-w-0 font-black">{item.title}</h3>
          </div>
          <p class="text-body text-ink">{item.body}</p>
          {showBadge(item.id) && (
            <span
              lang="ar"
              dir="rtl"
              class="bg-primary-bg text-primary-text text-caption rounded-pill self-start px-4 py-1 font-bold"
            >
              {t.arabicBadge}
            </span>
          )}
        </BlobCard>
      );
    })}
  </ul>
</Section>
