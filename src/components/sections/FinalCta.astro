---
import Container from "@/components/ui/Container.astro";
import CtaBand from "@/components/ui/CtaBand.astro";
import { getDictionary, type Locale } from "@/i18n";

/**
 * Section 12a: final CTA band (Figma 1457:4197, AR 1434:4017).
 *
 * The green blob is 1200x910 in Figma but only its top ~380px is visible: the footer's scalloped top edge
 * (see Footer.astro) overlaps its lower part. So the band (CtaBand size="final", a `bleed` BlobCard) keeps its
 * bottom padding at `--wave-h` + 32 and the footer pulls itself up by `--wave-h`; the blob continues underneath
 * the footer wave. Like every BlobCard, the blob is chosen by the band's own width: the SVG from 900px, a rounded
 * card below. The band and its buttons are shared with Setup (ui/CtaBand.astro).
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = getDictionary(locale).sections.footer;
---

<section id="contact" aria-labelledby="final-cta-title" class="relative">
  <Container>
    <CtaBand locale={locale} size="final" id="final-cta-title" title={s.cta.title} lead={s.cta.lead} />
  </Container>
</section>
