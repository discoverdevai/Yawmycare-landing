---
import Section from "@/components/ui/Section.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import BlobCard from "@/components/ui/BlobCard.astro";
import Icon from "@/components/ui/Icon.astro";
import { getDictionary, type Locale } from "@/i18n";

/**
 * Section 03 · Testimonials. Intro, then (>= 1280) one row of label + three quote blobs on the 4-up
 * grid (282 + 24 gap); below that the label becomes a row above the cards. No wave: it sits 32px under
 * the hero's own bottom wave (the one-off join, spec §8.1).
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).sections.testimonials;
---

<Section id="testimonials" headingId="testimonials-title" class="pt-(--wave-gap)">
  <SectionHeader slot="header" id="testimonials-title" title={t.title} lead={t.lead} />

  <div class="grid grid-cols-1 items-center gap-x-6 gap-y-8 xl:grid-cols-4">
    <div class="flex flex-col gap-4 max-xl:flex-row max-xl:items-center max-xl:gap-6">
      <Icon name="quote" size={67} class="text-ink shrink-0" />
      <h3 class="text-h3 text-ink min-w-0 font-bold">{t.label}</h3>
    </div>

    <ul role="list" class="grid grid-cols-1 gap-6 md:grid-cols-3 xl:col-span-3">
      {t.items.map((item) => (
        <BlobCard as="li" shape="testimonial" stretch contentClass="flex min-h-full flex-col justify-center p-6">
          <blockquote class="flex flex-col gap-4">
            <p class="text-title md:text-body lg:text-title font-medium">{item.quote}</p>
            <footer class="flex items-center gap-2">
              <span class="bg-accent text-ink-inverse inline-flex size-8 shrink-0 items-center justify-center rounded-full">
                <Icon name="profile" size={24} />
              </span>
              <cite class="text-accent-text text-caption font-bold not-italic">
                <bdi>{item.attribution}</bdi>
              </cite>
            </footer>
          </blockquote>
        </BlobCard>
      ))}
    </ul>
  </div>
</Section>
