---
import { Picture } from "astro:assets";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import WaveDivider from "@/components/ui/WaveDivider.astro";
import dashboard from "@/assets/product/owner-dashboard-1659-29977.webp";
import parentHome from "@/assets/product/parent-home-606-38038.webp";
import adminApp from "@/assets/product/admin-app-598-106917.webp";
import dashboardAr from "@/assets/product/ar/dashboard-ar.png";
import parentHomeAr from "@/assets/product/ar/parent-ar.png";
import adminAppAr from "@/assets/product/ar/admin-ar.png";
import { getDictionary, type Locale } from "@/i18n";
import { resolveLink, demoVideoUrl, whatsappStart } from "@/config/site";

/**
 * Section 02: hero (Figma 1457:3898, AR reference 1434:3718).
 * The header (top bar + nav) is its own component; this starts under the nav row.
 *
 * Copy column + product composite (real Figma exports, cropped: owner dashboard 1659:29977 chart + recent activity,
 * parent home 606:38038, admin app 598:106917 from "Daily Attendance" down; the all-"20" stat cards are cropped out).
 * Desktop (>= 1024): two columns, the phones overlap the dashboard's lower edge. Below 1024 the composite goes under
 * the text and the two phones stack under the dashboard. The composite mirrors in RTL (logical insets); the screen
 * images are never flipped. The AR page uses the Arabic RTL mockups from the proposal Figma file (src/assets/product/ar, docs/FIX-LOG-arabic-screens.md).
 * Actions: ONE solid primary + at most ONE outline (WhatsApp when configured, else the tour when configured, else none).
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).sections.hero;

// "*word*" marks the coral highlight words; odd indexes after the split are highlighted.
const titleParts = t.title.split("*");

// Demo video (env PUBLIC_DEMO_VIDEO_URL, docs/ENV.md): not rendered in production while unset.
const watch = resolveLink(demoVideoUrl);

// WhatsApp (current region's number): not rendered in production while no region has one.
const regionsT = getDictionary(locale).regions;

// Arabic RTL mockups on the AR page, English app screens otherwise.
const isAr = locale === "ar";
const screens = isAr
  ? { dashboard: dashboardAr, parentHome: parentHomeAr, adminApp: adminAppAr }
  : { dashboard, parentHome, adminApp };
const wa = whatsappStart(locale, regionsT.whatsappMessage);
---

<section id="home" aria-labelledby="hero-title" class="hero relative mb-8 bg-surface-sec">
  <Container class="relative z-10 pt-8 md:pt-12 lg:pt-[72px]">
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 id="hero-title" class="hero-title text-ink font-semibold rtl:font-bold">
          {titleParts.map((part, i) => (i % 2 === 1 ? <span class="text-accent-display">{part}</span> : part))}
        </h1>
        <p class="text-lead text-ink-muted mt-4 max-w-[565px] font-medium md:mt-6 rtl:font-normal">{t.lead}</p>
        <div class="hero-actions mt-6 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
          <Button variant="primary" href="#demo" data-demo-open block class="sm:w-auto sm:min-w-[282px]">
            {t.ctaPrimary}
          </Button>
          {wa.render ? (
            <Button
              variant="outline"
              icon="whatsapp"
              href={wa.href}
              external={!wa.unconfigured}
              unconfigured={wa.unconfigured}
              hidden={wa.hidden}
              data-wa-link
              data-wa-text={regionsT.whatsappMessage}
              block
              class="sm:w-auto"
            >
              {regionsT.chatOnWhatsApp}
            </Button>
          ) : (
            watch.render && (
              <Button
                variant="outline"
                href={watch.href}
                external={!watch.unconfigured}
                unconfigured={watch.unconfigured}
                block
                class="sm:w-auto"
              >
                {t.ctaWatch}
              </Button>
            )
          )}
        </div>
        <p class="text-body-sm text-ink-muted mt-4">{t.languageNote}</p>
      </div>

      <div class="composite" role="img" aria-label={t.imageAlt}>
        <div class="shot shot-dash">
          <Picture
            src={screens.dashboard}
            alt=""
            formats={["avif"]}
            fallbackFormat="webp"
            widths={[560, 840, 1120, 1600]}
            sizes="(min-width: 48rem) 36rem, calc(100vw - 2rem)"
            width={1600}
            height={913}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="block h-auto w-full"
          />
        </div>
        <div class="shot shot-parent">
          <Picture
            src={screens.parentHome}
            alt=""
            formats={["avif"]}
            fallbackFormat="webp"
            widths={[200, 300, 450, 750]}
            sizes="(min-width: 48rem) 13rem, 40vw"
            width={750}
            height={1624}
            loading="eager"
            fetchpriority="low"
            decoding="async"
            class="block h-auto w-full"
          />
        </div>
        <div class="shot shot-admin">
          <Picture
            src={screens.adminApp}
            alt=""
            formats={["avif"]}
            fallbackFormat="webp"
            widths={[200, 300, 450, 750]}
            sizes="(min-width: 48rem) 11rem, 34vw"
            width={750}
            height={1402}
            loading="eager"
            fetchpriority="low"
            decoding="async"
            class="block h-auto w-full"
          />
        </div>
      </div>
    </div>
  </Container>

  <div class="absolute inset-x-0 bottom-0 z-20">
    <WaveDivider direction="up" shadow="glow" class="bg-surface" />
  </div>
</section>

<style>
  .hero {
    padding-bottom: calc(var(--wave-h) + 1.5rem);
  }
  .hero-grid {
    display: grid;
    gap: 2.5rem;
  }
  .hero-title {
    /* ~64px at 1440 (Figma), fluid and rem-based so browser text zoom still scales it. */
    font-size: clamp(2.375rem, 0.5rem + 4.1vw, 3.75rem);
    line-height: var(--lh-normal);
    text-wrap: balance;
  }
  :global(:root:lang(ar)) .hero-title {
    font-size: clamp(2.375rem, 0.5rem + 4.1vw, 3.75rem);
  }

  /* Composite: shared look. */
  .composite {
    position: relative;
    width: 100%;
    max-width: 34rem;
    margin-inline: auto;
  }
  .shot {
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-stroke-green);
    box-shadow: 0 1.5rem 2.5rem -1.25rem color-mix(in srgb, var(--color-primary-text) 38%, transparent);
  }
  .shot-dash {
    border-radius: 1.25rem;
  }
  .shot-parent,
  .shot-admin {
    border-radius: 1.5rem;
    border-width: 3px;
    border-color: var(--color-primary-text);
    box-shadow: 0 1.75rem 2.5rem -1rem color-mix(in srgb, var(--color-primary-text) 45%, transparent);
  }

  /* Mobile / tablet: phones stack under the dashboard, overlapping its lower edge a little. */
  .composite {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding-inline: 0;
  }
  .shot-dash {
    grid-column: 1 / -1;
  }
  .shot-parent,
  .shot-admin {
    width: min(100%, 11.5rem);
    margin-top: -2.5rem;
    position: relative;
  }
  .shot-parent {
    justify-self: end;
  }
  .shot-admin {
    justify-self: start;
    margin-top: -1rem;
  }

  @media (min-width: 48rem) {
    .composite {
      display: block;
      max-width: 36rem;
      /* height = phone height + breathing room; everything is a % of the box so it scales as one piece */
      aspect-ratio: 1 / 0.86;
    }
    .shot {
      position: absolute;
    }
    .shot-dash {
      top: 0;
      inset-inline-end: 0;
      width: 92%;
    }
    .shot-parent {
      bottom: 0;
      inset-inline-start: 0;
      width: 35%;
      margin: 0;
      z-index: 2;
    }
    .shot-admin {
      bottom: 0;
      inset-inline-end: 0;
      width: 29%;
      margin: 0;
      z-index: 2;
    }
  }
  @media (min-width: 75rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      align-items: center;
      gap: 2rem;
    }
    .composite {
      max-width: none;
      /* bleeds up to 120px toward the viewport edge on wide screens (stays inside the gutter below that) */
      margin-inline: 0 clamp(-7.5rem, calc((var(--container-content) - 100vw) / 2 + 1rem), 0rem);
    }
  }
</style>
