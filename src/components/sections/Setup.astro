---
import Section from "@/components/ui/Section.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import BlobCard from "@/components/ui/BlobCard.astro";
import Button from "@/components/ui/Button.astro";
import ConnectorLines from "./setup/ConnectorLines.astro";
import { getDictionary, type Locale } from "@/i18n";
import { resolveLink, demoVideoUrl } from "@/config/site";

/**
 * Section 06: four numbered steps on BlobCard shape="step" joined by dashed connector lines, then the
 * green CTA band (BlobCard shape="cta-band").
 *
 *  >= 1024  four columns; numbered circle above each card, one horizontal dashed rail with a drop per
 *           column (ConnectorLines). Circles are centred on the cards, as in Figma.
 *  640-1023 2x2 grid; circle centred above each card (no rail), cards of a row share one height.
 *  <  640   one column; circle on the start side of each card, a vertical dashed line through the
 *           circles. Cards are capped at 288px so the 282x201 blob is never stretched much.
 * Grid and flex order follow `dir`, so step 1 lands on the right in Arabic (AR frame 1434:3912).
 *
 * Contrast (docs/sections/06-setup/review.md): the band uses `primary-cta-strong` instead of Figma's
 * `primary-cta` because the 18px bold button labels and the lead are normal-size text and need 4.5:1.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const t = dict.sections.setup;

// Demo video (env PUBLIC_DEMO_VIDEO_URL, docs/ENV.md): not rendered in production while unset; the Book a Demo
// button then stays centred (the row is justify-center and the button keeps its 386px cap).
const watch = resolveLink(demoVideoUrl);

// Dashed vertical line on the start side below 640 (token colour, no raw hex); sm+ has no vertical line (2x2 grid, then the ConnectorLines rail at lg).
const verticalLine =
  "after:absolute after:start-[23.5px] after:top-6 after:h-[calc(100%+1.5rem)] after:w-px after:content-[''] " +
  "after:bg-[repeating-linear-gradient(to_bottom,var(--color-stroke-green)_0_10px,transparent_10px_19px)] " +
  "last:after:hidden sm:after:hidden";
// Dot at the foot of each rail drop (desktop): the drop ends 16px above the circle.
const railDot =
  "lg:before:absolute lg:before:-top-[19px] lg:before:start-1/2 lg:before:-ms-[3px] lg:before:size-1.5 " +
  "lg:before:rounded-full lg:before:bg-stroke-green lg:before:content-['']";
---

<Section id="setup" headingId="setup-title" wave="down" shadow gap="loose">
  <SectionHeader slot="header" id="setup-title" title={t.title} lead={t.lead} />

  <div class="flex flex-col gap-8 lg:gap-12">
    <div class="relative lg:pt-[129px]">
      <ConnectorLines
        class="pointer-events-none absolute start-[calc((100%-4.5rem)/8)] top-0 hidden h-28 w-[calc((100%-4.5rem)*3/4+4.5rem)] lg:block"
      />
      <ol role="list" class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-y-10 lg:grid-cols-4">
        {
          t.steps.map((step, i) => (
            <li
              class:list={[
                "relative grid grid-cols-[3rem_minmax(0,1fr)] items-start gap-x-4 sm:flex sm:flex-col sm:items-center sm:gap-6",
                verticalLine,
                railDot,
              ]}
            >
              <BlobCard shape="step-number" class="relative z-10 size-12 shrink-0" contentClass="grid size-full place-items-center p-0">
                <span aria-hidden="true" class="text-h3 text-primary-text leading-none font-bold">{i + 1}</span>
              </BlobCard>
              <BlobCard shape="step" class="w-full max-w-72 min-w-0 sm:flex sm:max-w-none sm:flex-1 sm:flex-col sm:[&>div]:flex-1" contentClass="px-4 pt-8 pb-5">
                <div class="flex flex-col gap-3">
                  <h3 class="text-title text-primary-text font-bold lg:min-h-[2.6em]">{step.title}</h3>
                  <p class="text-body-sm text-ink">{step.body}</p>
                </div>
              </BlobCard>
            </li>
          ))
        }
      </ol>
    </div>

    <BlobCard
      shape="cta-band"
      fill="primary-cta-strong"
      contentClass="px-6 py-10 @min-[900px]:px-[58px] @min-[900px]:pt-12 @min-[900px]:pb-10"
    >
      <div class="flex flex-col items-center gap-[30px] text-center">
        <div class="flex flex-col items-center gap-(--lead-gap)">
          <SectionHeader align="center" tone="on-green" size="band" headingLevel={3} title={t.band.title} class="[&_h3]:text-balance" />
          <p class="text-lead text-ink-inverse">{t.band.lead}</p>
        </div>
        <div class="flex w-full flex-col items-stretch justify-center gap-4 @min-[640px]:flex-row">
          <Button variant="on-green" href="#demo" data-demo-open class="@min-[640px]:max-w-[386px] @min-[640px]:grow @min-[640px]:basis-0">
            {dict.cta.bookDemo}
          </Button>
          {watch.render && (
            <Button
              variant="on-green-outline"
              href={watch.href}
              external={!watch.unconfigured}
              unconfigured={watch.unconfigured}
              class="@min-[640px]:max-w-[386px] @min-[640px]:grow @min-[640px]:basis-0"
            >
              {dict.cta.watchDemo}
            </Button>
          )}
        </div>
      </div>
    </BlobCard>
  </div>
</Section>
