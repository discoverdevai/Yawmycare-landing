---
/**
 * Pricing illustration: animated WebP, swapped for its first frame when the visitor prefers reduced motion
 * (WCAG 2.2.2; stills come from docs/sections/09-pricing/make-stills.mjs). A plain <img> on purpose:
 * astro:assets would re-encode the animation flat. Decorative, so `alt=""`.
 */
interface Props {
  anim: ImageMetadata;
  still: ImageMetadata;
  /** Classes for the <img> (size, position). */
  class?: string;
}

const { anim, still, class: className = "" } = Astro.props;
// srcset splits on spaces, and the dev server serves assets from a path that can contain one.
const spaceSafe = (url: string) => url.replace(/ /g, "%20");
---

<picture class="contents">
  <source media="(prefers-reduced-motion: reduce)" srcset={spaceSafe(still.src)} type="image/webp" />
  <img src={anim.src} width={375} height={375} alt="" loading="lazy" decoding="async" class={className} />
</picture>
