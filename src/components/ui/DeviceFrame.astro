---
/**
 * Device frame for REAL product screens (art direction, Figma 14:2 "Device frame: 4px ink stroke, radius 26 to 36,
 * soft shadow"). Pure CSS, symmetric in LTR and RTL; the screen inside is never redrawn or mirrored.
 *  - `phone`:   4px ink bezel, rounded 2.25rem, no notch (the screens already carry their own status bar).
 *  - `browser`: 4px ink-green frame with a quiet top bar (three dots + an empty address pill) for the owner dashboard.
 * `rise` opts into the calm first-view rise (see global.css [data-rise]); it never touches the screen content.
 */
interface Props {
  kind?: "phone" | "browser";
  rise?: "load" | "view" | false;
  class?: string;
  style?: string;
}
const { kind = "phone", rise = false, class: className = "", style } = Astro.props;
---

<div class:list={["device", `device--${kind}`, className]} data-rise={rise || undefined} style={style}>
  {kind === "browser" && (
    <div class="device-bar" aria-hidden="true">
      <i />
      <i />
      <i />
      <b />
    </div>
  )}
  <div class="device-screen">
    <slot />
  </div>
</div>

<style>
  .device {
    overflow: hidden;
    background: var(--color-surface);
    border: 4px solid var(--color-primary-text);
    box-shadow:
      0 1.75rem 2.5rem -1.25rem color-mix(in srgb, var(--color-primary-text) 38%, transparent),
      0 0.25rem 0.75rem -0.25rem color-mix(in srgb, var(--color-primary-text) 18%, transparent);
  }
  .device--phone {
    border-radius: 2.25rem;
  }
  .device--browser {
    border-radius: 1.75rem;
    border-width: 3px;
    border-color: var(--color-stroke-green);
  }
  .device-screen {
    display: block;
  }
  .device-bar {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    block-size: 1.75rem;
    padding-inline: 0.875rem;
    background: var(--color-primary-bg);
    border-block-end: 1px solid var(--color-stroke-green);
  }
  .device-bar i {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background: var(--color-primary-cta-strong);
    opacity: 0.55;
  }
  .device-bar b {
    flex: 1;
    max-inline-size: 45%;
    margin-inline: auto;
    block-size: 0.875rem;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
  }
</style>

<script>
  // Devices below the fold rise once, the first time they are on screen. Armed only for visitors who allow motion; the
  // hero ("load") is CSS-only. Without JS or IntersectionObserver nothing is ever hidden.
  const els = document.querySelectorAll<HTMLElement>('[data-rise="view"]');
  if (els.length && "IntersectionObserver" in window && matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          (e.target as HTMLElement).removeAttribute("data-rise-armed");
          io.unobserve(e.target);
        }),
      { threshold: 0.15 },
    );
    els.forEach((el) => {
      if (el.getBoundingClientRect().top < innerHeight) return;
      el.setAttribute("data-rise-armed", "");
      io.observe(el);
    });
  }
</script>
