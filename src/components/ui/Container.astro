---
/**
 * Centred content column. 1200px at the 1440 canvas (120px margins), with --gutter side padding on
 * smaller screens. `wide` (1280) is only for the nav.
 */
interface Props {
  size?: "content" | "wide";
  as?: "div" | "header" | "footer" | "nav";
  class?: string;
}

const { size = "content", as: Tag = "div", class: className = "" } = Astro.props;
---

<Tag class:list={["container-c", size === "wide" && "container-c--wide", className]}>
  <slot />
</Tag>

<style>
  .container-c {
    width: min(100% - 2 * var(--gutter), var(--container-content));
    margin-inline: auto;
  }
  .container-c--wide {
    width: min(100% - 2 * var(--gutter), var(--container-wide));
  }
</style>
