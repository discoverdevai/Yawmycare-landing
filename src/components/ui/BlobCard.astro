---
import type { HTMLAttributes } from "astro/types";

/**
 * Card with one of the hand-drawn organic outlines from Figma.
 *
 * SHAPE RULE (one shape language, responsive pass 2):
 *  1. A card is ALWAYS the scalloped SVG or ALWAYS the plain fallback for a given width of its own box, decided by a
 *     container query at 55% of the shape's native width (literal thresholds in the lookup below). Cards of one family
 *     share a column width, so they can never mix on one screen; compact families (feature, step, security,
 *     testimonial, commitments, intl-school) stay scalloped from 390 up, and only the one-per-section banners
 *     (cta-band, final-cta, pricing, founder-text, first10, commitment-wide) fall back to plain on a phone.
 *  2. The fallback is the same card minus the scallops: same fill, same stroke colour and width (a real border), and
 *     the shared `rounded-card` radius (--radius-card, 32px). Never a different colour or a thinner line.
 *  3. Fill-only shapes that sit on the page background get an `outline` (CSS stroke on the SVG path, border on the
 *     fallback) so their edge reads at >= 1.3:1.
 *  4. There is NO aspect lock and no min-height: the frame is as tall as its content (or, in equal-height rows, as tall
 *     as `stretch` makes it). The SVG uses preserveAspectRatio="none" so it follows the box. Empty space is a content
 *     problem, never a shape problem. (`bleed` is the one exception: the final CTA SVG keeps its native height.)
 * Shapes are not mirrored in RTL (the AR Figma frame uses them unmirrored).
 *
 * Tailwind needs literal class strings, so the per-shape thresholds live in the lookup below.
 */
const svgs = import.meta.glob<{ default: (props: HTMLAttributes<"svg">) => unknown }>("@/assets/shapes/*.svg", {
  eager: true,
});

interface ShapeConfig {
  w: number;
  h: number;
  fill: string;
  /** Stroke colour. Shapes whose SVG already contains the outline draw it themselves; `outline` shapes get it from CSS. */
  stroke?: string;
  /** Visible stroke width in px; the fallback border uses exactly this. */
  strokeW?: number;
  /** The SVG has no stroke of its own: draw `stroke` on its path with CSS (non-scaling), as the fallback border does. */
  outline?: boolean;
  /** Literal classes: show the SVG from 55% of native width, hide the fallback from there. */
  show: string;
  hide: string;
}

const C = (name: string) => `var(--color-${name})`;

const shapes = {
  feature: {
    w: 384,
    h: 312,
    fill: C("surface-tabs"),
    stroke: C("stroke-green"),
    strokeW: 3,
    show: "@min-[211px]:block",
    hide: "@min-[211px]:hidden",
  },
  step: {
    w: 282,
    h: 201,
    fill: C("surface-tabs"),
    stroke: C("stroke-green"),
    strokeW: 3,
    show: "@min-[155px]:block",
    hide: "@min-[155px]:hidden",
  },
  "step-number": {
    w: 48,
    h: 48,
    fill: C("surface-tabs"),
    stroke: C("stroke-green"),
    strokeW: 3,
    show: "@min-[36px]:block",
    hide: "@min-[36px]:hidden",
  },
  "cta-band": { w: 1200, h: 348, fill: C("primary-cta"), show: "@min-[660px]:block", hide: "@min-[660px]:hidden" },
  "final-cta": { w: 1200, h: 910, fill: C("primary-cta"), show: "@min-[660px]:block", hide: "@min-[660px]:hidden" },
  testimonial: {
    w: 282,
    h: 236,
    fill: C("accent-bg-soft"),
    show: "@min-[155px]:block",
    hide: "@min-[155px]:hidden",
  },
  security: {
    w: 282,
    h: 416,
    fill: C("accent-bg-light"),
    stroke: C("stroke-accent-strong"),
    strokeW: 3,
    show: "@min-[155px]:block",
    hide: "@min-[155px]:hidden",
  },
  "commitment-peach": {
    w: 588,
    h: 247,
    fill: C("accent-bg-light"),
    stroke: C("stroke-accent-strong"),
    strokeW: 2,
    outline: true,
    show: "@min-[324px]:block",
    hide: "@min-[324px]:hidden",
  },
  "commitment-green": {
    w: 588,
    h: 247,
    fill: C("surface-tabs"),
    stroke: C("stroke-green"),
    strokeW: 2,
    outline: true,
    show: "@min-[324px]:block",
    hide: "@min-[324px]:hidden",
  },
  "commitment-wide": {
    w: 1200,
    h: 183,
    fill: C("stroke-sec"),
    stroke: C("stroke-green"),
    strokeW: 2,
    outline: true,
    show: "@min-[660px]:block",
    hide: "@min-[660px]:hidden",
  },
  pricing: { w: 1200, h: 424, fill: C("primary-bg"), show: "@min-[660px]:block", hide: "@min-[660px]:hidden" },
  "intl-school": {
    w: 384,
    h: 503,
    fill: C("stroke-sec"),
    show: "@min-[211px]:block",
    hide: "@min-[211px]:hidden",
  },
  first10: {
    w: 792,
    h: 503,
    fill: C("accent-bg-light"),
    stroke: C("accent-text"),
    strokeW: 2,
    show: "@min-[436px]:block",
    hide: "@min-[436px]:hidden",
  },
  "founder-text": { w: 1181, h: 423, fill: C("primary-bg"), show: "@min-[650px]:block", hide: "@min-[650px]:hidden" },
} satisfies Record<string, ShapeConfig>;

export type BlobShape = keyof typeof shapes;

interface Props {
  shape: BlobShape;
  as?: "div" | "li" | "article" | "blockquote";
  /** Padding etc. for the content layer. Figma cards use 32px. */
  contentClass?: string;
  class?: string;
  /** Overrides the shape's fill with another colour token name (e.g. "primary-cta-strong" for a text-bearing band). */
  fill?: string;
  /** Mirrors the SVG outline horizontally (e.g. founders: the scalloped edge sits opposite the photo). */
  flip?: boolean;
  /**
   * The card fills the height its parent gives it (equal-height grid rows / flex columns): the card is a flex column
   * and the frame grows. The content layer keeps its own height unless `fillContent` is set. Replaces the `[&>div]:flex-1` selectors sections used to aim at this component's inner div.
   * `true` always; `"sm"` / `"lg"` only from that viewport breakpoint up.
   */
  stretch?: boolean | "sm" | "lg";
  /**
   * The frame is as tall as its content, not the shape's native aspect ratio; the SVG keeps its native height,
   * pinned to the top, and runs past the frame (clip it with `overflow-y-clip` on the card). Used by the final
   * CTA, whose 910px blob is mostly covered by the footer's scalloped edge. The rounded fallback fills the frame.
   */
  bleed?: boolean;
  /** With `stretch`: the content layer grows to the frame's height too (so `flex-1` / `mt-auto` inside it can pin to the bottom). */
  fillContent?: boolean;
}

const {
  shape,
  as: Tag = "div",
  contentClass = "p-8",
  class: className = "",
  fill,
  flip = false,
  stretch = false,
  bleed = false,
  fillContent = false,
} = Astro.props;

// Literal class strings so Tailwind sees them: [outer card, frame, frame when the content layer fills it].
const stretchClasses = {
  true: ["flex flex-col", "flex-1", "flex flex-col"],
  sm: ["sm:flex sm:flex-col", "sm:flex-1", "sm:flex sm:flex-col"],
  lg: ["lg:flex lg:flex-col", "lg:flex-1", "lg:flex lg:flex-col"],
} as const;
const [stretchCard, stretchFrame, fillFrame] = stretch ? stretchClasses[stretch === true ? "true" : stretch] : [];

const cfg: ShapeConfig = shapes[shape];
const Svg = svgs[`/src/assets/shapes/${shape}.svg`]?.default;
if (!Svg) throw new Error(`Blob shape "${shape}" not found in src/assets/shapes`);

const vars =
  `--blob-fill:${fill ? C(fill) : cfg.fill};` +
  `--blob-stroke:${cfg.stroke ?? "transparent"};` +
  `--blob-stroke-w:${cfg.strokeW ?? 0}px;` +
  `--blob-h:${cfg.h}px`;
---

<Tag class:list={["@container", stretchCard, className]} style={vars}>
  <div class:list={["relative", stretchFrame, fillContent && fillFrame]}>
    <Svg
      class:list={[
        "pointer-events-none absolute hidden",
        bleed ? "inset-x-0 top-0 h-(--blob-h) w-full" : "inset-0 size-full",
        flip && "-scale-x-100",
        cfg.outline && "blob-outline",
        cfg.show,
      ]}
      aria-hidden="true"
      focusable="false"
    />
    <div
      aria-hidden="true"
      class:list={[
        "rounded-card pointer-events-none absolute inset-0 border-(length:--blob-stroke-w) border-(--blob-stroke) bg-(--blob-fill)",
        cfg.hide,
      ]}
    ></div>
    <div class:list={["relative flex-1", contentClass]}>
      <slot />
    </div>
  </div>
</Tag>

<style is:global>
  /* Fill-only shapes: the outline is a CSS stroke on the path, constant width at any scale, same as the fallback border. */
  .blob-outline path {
    stroke: var(--blob-stroke);
    stroke-width: var(--blob-stroke-w);
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
</style>
