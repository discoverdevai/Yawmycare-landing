---
import { getDictionary, type Locale } from "@/i18n";

/**
 * Page-level "pause animations" control (WCAG 2.2.2). One toggle for every <AnimatedImage>: while pressed, each
 * animation is swapped for its still frame. Fixed to the inline-start bottom corner so it never sits in the
 * content flow. Hidden without JS (it could do nothing) and when the visitor already prefers reduced motion
 * (every animation is a still then). State lives only in the page: nothing is stored.
 */
interface Props {
  locale: Locale;
}

const label = getDictionary(Astro.props.locale).a11y.pauseAnimations;
---

<button
  type="button"
  hidden
  data-motion-toggle
  aria-pressed="false"
  title={label}
  class="group bg-surface text-primary-text border-primary-cta-strong focus-visible:outline-focus hover:bg-primary-bg fixed bottom-4 start-4 z-40 flex size-11 items-center justify-center rounded-full border-2 shadow-md focus-visible:outline-2 focus-visible:outline-offset-2"
>
  <span class="sr-only">{label}</span>
  <svg viewBox="0 0 24 24" class="size-5 group-aria-pressed:hidden" fill="currentColor" aria-hidden="true">
    <rect x="6" y="5" width="4" height="14" rx="1"></rect>
    <rect x="14" y="5" width="4" height="14" rx="1"></rect>
  </svg>
  <svg
    viewBox="0 0 24 24"
    class="hidden size-5 group-aria-pressed:block rtl:-scale-x-100"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"></path>
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-motion-toggle]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (button) {
    const sync = () => {
      button.hidden = reduce.matches;
    };
    sync();
    reduce.addEventListener("change", sync);
    button.addEventListener("click", () => {
      const paused = button.getAttribute("aria-pressed") !== "true";
      button.setAttribute("aria-pressed", String(paused));
      document.querySelectorAll<HTMLImageElement>("img[data-anim]").forEach((img) => {
        img.src = (paused ? img.dataset.still : img.dataset.anim) ?? img.src;
      });
    });
  }
</script>
