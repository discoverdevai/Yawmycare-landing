---
import "@/styles/global.css";
import { getDictionary, localeMeta, locales, type Locale } from "@/i18n";
import { fontFaceCss, fontPreloads } from "@/styles/fonts";
import MotionToggle from "@/components/ui/MotionToggle.astro";
import RegionData from "@/components/ui/RegionData.astro";
import WhatsAppFab from "@/components/ui/WhatsAppFab.astro";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Locales in which THIS page exists (hreflang set). Default: all. Sub-pages pass only the locales that were generated. */
  alternateLocales?: readonly Locale[];
}

const { locale, title, description, noindex = false, alternateLocales = locales } = Astro.props;
const t = getDictionary(locale);
const { dir, htmlLang } = localeMeta[locale];

const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternates = alternateLocales.map((l) => ({
  locale: l,
  href: new URL(Astro.url.pathname.replace(`/${locale}`, `/${l}`), Astro.site).href,
}));

// Social sharing. Facebook locale codes: ar_AR / en_US. Images: public/og/og-{en,ar}.png, regenerated by scripts/generate-og.mjs.
const ogImage = new URL(`/og/og-${locale}.png`, Astro.site).href;
const ogLocale = locale === "ar" ? "ar_AR" : "en_US";
const ogAlternate = alternateLocales.filter((l) => l !== locale).map((l) => (l === "ar" ? "ar_AR" : "en_US"));
const ogAlt = `${t.brand.name}: ${t.brand.tagline}`;
---

<!doctype html>
<html lang={htmlLang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    )}
    {!noindex && <link rel="canonical" href={canonical.href} />}
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={a.href} />)}
    {!noindex && alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />}
    {/* The one raw hex outside global.css: a meta tag cannot read a CSS variable. Keep in sync with --color-primary-cta-strong. */}
    <meta name="theme-color" content="#5e7748" />
    {/* Social tags only on indexable pages: a noindex page (404) is never shared as a card. */}
    {!noindex && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={t.brand.name} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:url" content={canonical.href} />
        <meta property="og:locale" content={ogLocale} />
        {ogAlternate.map((l) => (
          <meta property="og:locale:alternate" content={l} />
        ))}
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={pageDescription} />
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:image:alt" content={ogAlt} />
      </>
    )}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* Fonts: licensed Recoleta / Expo Arabic are preloaded when present (fonts.ts). The open-licence stand-ins (Fraunces, Readex Pro)
        ship with font-display: swap from @fontsource-variable (checked by scripts/seo-verify.mjs); Vite hashes their file names, so they
        cannot be preloaded by a stable URL until the licensed WOFF2 files replace them (docs/FIX-LOG-final-copy.md). */}
    {fontPreloads(locale).map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}
    {fontFaceCss && <style is:inline set:html={fontFaceCss} />}
    <slot name="head" />
  </head>
  <body class="bg-surface text-ink antialiased">
    <a
      href="#main"
      class="bg-primary-text text-ink-inverse focus-visible:outline-focus sr-only z-50 rounded-lg focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:px-4 focus:py-2 focus-visible:outline-2 focus-visible:outline-offset-2"
    >
      {t.a11y.skipToContent}
    </a>
    <slot name="header" />
    <MotionToggle locale={locale} />
    <RegionData />
    <WhatsAppFab locale={locale} />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
    {/* Opt-in analytics: a no-op unless PUBLIC_ANALYTICS_* is set (docs/CRO.md). Module scripts are deferred. */}
    <script>
      import "@/scripts/analytics";
    </script>
  </body>
</html>
